# Copy to .env.local (local) or add in Vercel > Settings > Environment Variables

# Hostinger business mailbox (SMTP) - used to send order emails
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=sales@vapesshopcanada.com
SMTP_PASSWORD=
# Where you receive the order notification
ORDER_TO_EMAIL=sales@vapesshopcanada.com
# Customer confirmation is on by default; set to false to turn it off
SEND_CUSTOMER_CONFIRMATION=true

# Optional alternative: Resend (only used if SMTP_USER / SMTP_PASSWORD are not set)
# RESEND_API_KEY=
# ORDER_FROM_EMAIL=Vape Shop Canada <sales@vapesshopcanada.com>
